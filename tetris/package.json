{
  "name": "z-spin",
  "version": "1.0.0",
  "description": "A Tetris game built with Phaser 3, TypeScript, Rollup, and WebAssembly",
  "main": "dist/bundle.js",
  "scripts": {
    "dev": "rollup -c -w",
    "build": "cd ../engine && ./build.sh && cd ../tetris && rollup -c",
    "start": "node server.js",
    "build:wasm": "cd ../engine && ./build.sh",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\""
  },
  "keywords": [
    "phaser",
    "tetris",
    "typescript",
    "rollup",
    "wasm",
    "webassembly",
    "rust"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "phaser": "^3.80.1",
    "prettier": "^3.3.3",
    "rollup": "^4.9.6",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0"
  }
} 